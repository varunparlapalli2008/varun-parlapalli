# Royal Atelier Portfolio Environment Configuration
# Copy this file to .env.local and populate with your credentials if desired.

# Optional AI Engine Configuration for "Ask Varun's AI"
# If omitted, the application uses its built-in bounded portfolio grounding engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Email Dispatch Delivery (Resend API)
# If omitted, the contact form provides a truthful "Prepare email" client fallback.
RESEND_API_KEY=your_resend_api_key_here

# Site URL Configuration
NEXT_PUBLIC_SITE_URL=https://varun-parlapalli.vercel.app/

# ==========================================
# Studio CMS Authentication (Server-side Only)
# ==========================================
# Email address of the authorized owner
ADMIN_EMAIL=varunparlapalli2008@gmail.com

# Scrypt hash of the owner password (never store plain password in production)
# Format: scrypt:<salt_hex>:<derived_key_hex>
ADMIN_PASSWORD_HASH=scrypt:3521d278629a17035556e412f57e210b:123e8c12027186ef7904cca72698100abf2811c6ee1c9fc6c6c2be3f2f48087a9278816bca67ff45b628ec89e60d18fada4ff129d0deecc68f76c2da3f7b596c
# Secret key used to HMAC-sign session cookies (generate with crypto.randomBytes(32).toString('hex'))
SESSION_SECRET=17d10f07355ab04c0fce9a6649da64d254c10f46d098b28afd44901287bbd96d
# ==========================================
# Production Content Storage (GitHub Contents API)
# ==========================================
# Fine-grained personal access token with 'Contents' read & write permission on the portfolio repository
GITHUB_CONTENT_TOKEN=

# Target repository and content store path
GITHUB_REPO=varunparlapalli2008/varun-parlapalli
GITHUB_CONTENT_PATH=data/portfolio-store.json
